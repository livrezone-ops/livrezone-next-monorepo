APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Synchronisation Meilisearch via la queue (au lieu de bloquer la requête)
SCOUT_QUEUE=database

# Tarification & Abonnements (valeurs par défaut, modifiables depuis l'admin)
MAX_FREE_LISTINGS=25
PRO_PRICE=30
PREMIUM_PRICE=50
# PRO_PRICE_YEARLY / PREMIUM_PRICE_YEARLY : optionnels (défaut = mensuel x10)
PROMO_PRO_FREE=false
PRO_NOTIFICATION_DELAY_HOURS=3
SUBSCRIPTION_GRACE_PERIOD_DAYS=15

# Simulateur de paiement (tests uniquement - NE JAMAIS activer en production)
PAYMENT_SIMULATOR=false

# Reverb (WebSockets)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6060
REVERB_HOST=api-next.livrezone.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Anti-Scraping
ANTI_SCRAPING_ENABLED=false
ANTI_SCRAPING_MAX_REQUESTS=10

# Tarification & Abonnements
MAX_FREE_LISTINGS=25
PRO_PRICE=30
PREMIUM_PRICE=50
PROMO_PRO_FREE=false
PRO_NOTIFICATION_DELAY_HOURS=3
